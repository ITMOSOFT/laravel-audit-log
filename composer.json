{
    "name": "itmosoft/laravel-audit-log",
    "description": "Auditing for Eloquent models, business events, and Laravel queue lifecycle events.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "ItmoSoft\\AuditLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ItmoSoft\\AuditLog\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ItmoSoft\\AuditLog\\AuditLogServiceProvider"
            ],
            "aliases": {
                "AuditLog": "ItmoSoft\\AuditLog\\Facades\\AuditLog"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:feature": "phpunit --testsuite=Feature"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
